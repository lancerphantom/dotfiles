#!/usr/bin/env python3
"""rgb-fanfx [EFFECT [SPEED] [TARGETS]] [--on fans,kb,mouse] [--for SECONDS] | list
   Runs an effect from ~/.config/rgb-fx/ on the fans, keyboard and/or mouse."""
import importlib.util, subprocess, sys, time
from pathlib import Path
from openrgb import OpenRGBClient
from openrgb.utils import RGBColor
from tmkb_mouse import Mouse, MODES as MOUSE_MODES

HOME = Path.home()
FX_DIR, STATE = HOME / ".config/rgb-fx", HOME / ".cache/rgb-fx"
FAN_LEDS, FPS = 6, 30
KB_WB = (1.0, 0.565, 0.439)                 # keyboard white balance
DEV = {"ram": "Vengeance", "fans": "B550M", "mouse": None, "kb": "Apex 3"}   # OpenRGB device names (numbers change between boots); mouse uses tmkb_mouse
RAM_MODE = "custom"   # "custom": real per-LED effect on the RAM (Custom mode, ~15 updates/s)
                      # "shift":  fallback - whole stick one colour, 1 update/s via Color Shift
                      #           (use this if Custom shows a stuck green fade again)
RAM_FPS = 15          # custom mode: RAM is on the slow SMBus
RAM_HZ = 1.0          # shift mode: 3/s froze, 1/s keeps up

argv = sys.argv[1:]
def opt(flag):
    if flag in argv:
        i = argv.index(flag); v = argv[i + 1]; del argv[i:i + 2]; return v
dur = opt("--for"); dur = float(dur) if dur else None
on = opt("--on")

def effects():
    return sorted(p.stem for p in FX_DIR.glob("*.py") if not p.stem.startswith("_"))

def load(name):
    spec = importlib.util.spec_from_file_location(name, FX_DIR / f"{name}.py")
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
    return mod

if argv and argv[0] == "list":
    for e in effects():
        try: d = load(e).DESCRIPTION
        except Exception as ex: d = f"(error: {ex})"
        print(f"  {e:<12} {d}")
    sys.exit()

args = argv or (STATE.read_text().split() if STATE.exists() else ["spin"])
name = args[0]
speed = float(args[1]) if len(args) > 1 else 1.0
targets = [t for t in (on or (args[2] if len(args) > 2 else "fans,kb,mouse,ram")).split(",") if t in DEV]
if name not in effects():
    sys.exit(f"unknown effect '{name}' — available: {', '.join(effects())}")

_ws = importlib.util.spec_from_file_location("_wallpal", FX_DIR / "_wallpal.py")
WALL = importlib.util.module_from_spec(_ws); _ws.loader.exec_module(WALL)

def base_colour():
    """Wallpaper's main colour if settings.conf says colour = wallpaper, else your chosen colour."""
    return WALL.main_colour() or saved()

def saved():
    try: h = (HOME / ".cache/rgb-current").read_text().strip()
    except OSError: h = "00AAFF"
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def locked():
    return "true" in subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.ScreenSaver",
        "--object-path", "/ScreenSaver", "--method", "org.freedesktop.ScreenSaver.GetActive"],
        capture_output=True, text=True).stdout

def clamp(px):
    return tuple(int(max(0, min(255, c))) for c in px)

mode_cmd = ["openrgb"]
for t in targets:
    if t not in ("ram", "mouse"): mode_cmd += ["-d", DEV[t], "--mode", "direct"]
if len(mode_cmd) > 1: subprocess.run(mode_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
time.sleep(0.5)                                    # let the server settle after the mode switch
cli = OpenRGBClient("127.0.0.1", 6742, "rgb-fanfx")
def by_name(name):
    return next(d for d in cli.devices if name.lower() in d.name.lower())
dev = {t: by_name(DEV[t]) for t in targets if t != "mouse"}
mouse = None
if "mouse" in targets:
    try:
        mouse = Mouse(); mouse.mode(MOUSE_MODES["zones"])
    except OSError as ex:
        print("mouse unavailable:", ex, flush=True)
ram_mode = None
if "ram" in dev and RAM_MODE == "custom":          # RAM: per-LED Custom mode (slow bus, retry)
    for attempt in range(3):
        try:
            dev["ram"].set_mode("Custom"); time.sleep(1.5)
            dev["ram"].update()
            if dev["ram"].modes[dev["ram"].active_mode].name == "Custom":
                print("RAM: per-LED Custom mode", flush=True); break
            print("RAM mode switch did not stick, retrying", flush=True)
        except Exception as ex:
            print("RAM mode switch failed, retrying:", ex, flush=True); time.sleep(2)
    else:
        print("RAM Custom mode unavailable - falling back to whole-stick colour", flush=True)
        RAM_MODE = "shift"
if "ram" in dev and RAM_MODE == "shift":           # RAM: whole-stick colour through the Color Shift mode
    ram_mode = next((m for m in dev["ram"].modes if m.name == "Color Shift"), None)
    if ram_mode is None:
        print("RAM has no Color Shift mode — running without it", flush=True); dev.pop("ram")
ram_peak, ram_sent = (0, 0, 0), None

path = FX_DIR / f"{name}.py"
fx, mtime = load(name), path.stat().st_mtime
ram_t = 0.0
t0, last_check, paused, base = time.monotonic(), 0.0, False, base_colour()

def dly(d):
    return getattr(fx, "DELAYS", {}).get(d, 0.0)

def fr(d, t, base, n):
    """One device's frame. Effects may define frame_dev(device, t, base, n) to know which device
    they draw (keyboard, mouse, logo, fans, ram); otherwise frame(t, base, n) is used.
    DELAYS (per device, seconds) shifts each device's time; the logo follows the mouse."""
    tt = t - (dly(d) if d in getattr(fx, "DELAYS", {}) else dly("mouse") if d == "logo" else dly(d))
    if hasattr(fx, "frame_dev"):
        return fx.frame_dev(d, tt, base, n)
    return fx.frame(tt, base, n)

while True:
    now = time.monotonic()
    if dur and now - t0 > dur:
        break
    if now - last_check > 1:
        last_check, paused, base = now, locked(), base_colour()
        try:
            if path.stat().st_mtime != mtime:
                mtime = path.stat().st_mtime; fx = load(name); print(f"reloaded {name}", flush=True)
        except Exception as ex:
            print(f"reload failed, keeping old version: {ex}", flush=True)
    if paused:
        time.sleep(0.5); continue
    t = (now - t0) * speed
    try:
        if "fans" in dev:
            ring = [clamp(p) for p in fr("fans", t, base, FAN_LEDS)]
            cols = [RGBColor(b, r, g) for r, g, b in ring]                      # fan channel reorder
            dev["fans"].set_colors(cols + [RGBColor(0, 0, 0)] * (len(dev["fans"].leds) - len(cols)), fast=True)
        if "kb" in dev:
            n = len(dev["kb"].leds)
            zones = [clamp(p) for p in fr("keyboard", t, base, n)]
            dev["kb"].set_colors([RGBColor(*(int(c * w) for c, w in zip(p, KB_WB))) for p in zones], fast=True)
        if "ram" in dev and RAM_MODE == "custom":
            if now - ram_t >= 1 / RAM_FPS:
                ram_t = now
                px = [clamp(p) for p in fr("ram", t, base, len(dev["ram"].leds))]
                dev["ram"].set_colors([RGBColor(*p) for p in px], fast=True)
        elif "ram" in dev:
            px = fr("ram", t, base, len(dev["ram"].leds))
            avg = clamp(tuple(sum(c) / len(px) for c in zip(*px)))
            if sum(avg) > sum(ram_peak): ram_peak = avg          # brightest moment since the last update (keeps flashes)
            if now - ram_t >= 1 / RAM_HZ:
                ram_t = now
                if ram_peak != ram_sent:
                    ram_mode.colors = [RGBColor(*ram_peak)] * 2
                    dev["ram"].set_mode(ram_mode); ram_sent = ram_peak
                ram_peak = (0, 0, 0)
        if mouse:
            arc = [clamp(p) for p in fr("mouse", t, base, 5)]
            mouse.zones(arc + [clamp(fr("logo", t, base, 1)[0])])
    except Exception as ex:
        print(f"effect error: {ex}", flush=True); time.sleep(1)
    time.sleep(1 / FPS)
