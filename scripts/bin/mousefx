#!/usr/bin/env python3
"""mousefx — TMKB M1SE mouse lighting
  mousefx zones C1 [C2 ... C6]     5 arc zones left->right + logo (fewer values repeat)
  mousefx colours C1 ... C6        palette for 'mode breathing-multi'
  mousefx mode NAME|0xNN [SPEED 0-5] [BRIGHTNESS 0-7]
  mousefx list"""
import sys
from tmkb_mouse import Mouse, MODES, PALETTE

NAMES = {"red": "FF0000", "orange": "FF5500", "yellow": "FFFF00", "green": "00FF00", "cyan": "00FFFF",
         "blue": "0000FF", "purple": "8800FF", "pink": "FF00AA", "white": "FFFFFF", "black": "000000",
         "off": "000000", "sky": "00AAFF", "mint": "00FF88", "teal": "00FFCC", "magenta": "FF00FF"}

def rgb(s):
    h = NAMES.get(s.lower(), s.lstrip("#"))
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

a = sys.argv[1:]
if not a or a[0] == "list":
    print(__doc__); print("modes:", ", ".join(MODES)); sys.exit()
m = Mouse()
if a[0] == "zones":
    m.mode(MODES["zones"])
    m.zones([rgb(c) for c in a[1:]] or [rgb("white")])
elif a[0] == "colours":
    cols = [rgb(c) for c in a[1:]] or [rgb("white")]
    for i, s in enumerate(PALETTE):
        m.slot(s, cols[i % len(cols)], force=True)
elif a[0] == "mode":
    code = MODES[a[1]] if a[1] in MODES else int(a[1], 16)
    m.mode(code, int(a[2]) if len(a) > 2 else 2, int(a[3]) if len(a) > 3 else 7)
else:
    print(__doc__)
