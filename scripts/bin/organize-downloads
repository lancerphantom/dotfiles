#!/bin/bash

# Downloads Folder Organizer
# Sorts files into categorized subdirectories

DOWNLOADS_DIR="$HOME/Downloads"
DRY_RUN=false
VERBOSE=false
INTERACTIVE=false
CREATE_ONLY=false

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Directory structure
declare -A DIRS=(
    ["images"]="media/images"
    ["wallpapers"]="media/wallpapers"
    ["videos"]="media/videos"
    ["music"]="media/music"
    ["pdfs"]="documents/pdfs"
    ["office"]="documents/office"
    ["ebooks"]="documents/ebooks"
    ["appimages"]="software/appimages"
    ["archives"]="software/archives"
    ["installers"]="software/installers"
    ["debs"]="software/debs"
    ["courses"]="dev/courses"
    ["projects"]="dev/projects"
    ["grub"]="themes/grub"
    ["icons"]="themes/icons"
    ["fonts"]="themes/fonts"
    ["kde"]="themes/kde"
    ["torrents"]="torrents"
    ["temp"]="temp"
)

# File extension → category
declare -A EXT_MAP=(
    ["jpg"]="images"   ["jpeg"]="images"  ["png"]="images"
    ["gif"]="images"   ["webp"]="images"  ["svg"]="images"
    ["bmp"]="images"   ["ico"]="images"
    ["mp4"]="videos"   ["mkv"]="videos"   ["avi"]="videos"
    ["mov"]="videos"   ["webm"]="videos"  ["flv"]="videos"
    ["mp3"]="music"    ["flac"]="music"   ["wav"]="music"
    ["ogg"]="music"    ["aac"]="music"
    ["pdf"]="pdfs"
    ["doc"]="office"   ["docx"]="office"  ["xls"]="office"
    ["xlsx"]="office"  ["ppt"]="office"   ["pptx"]="office"
    ["odt"]="office"   ["ods"]="office"   ["odp"]="office"
    ["epub"]="ebooks"  ["mobi"]="ebooks"  ["azw3"]="ebooks"
    ["AppImage"]="appimages"
    ["deb"]="debs"
    ["iso"]="installers" ["img"]="installers"
    ["tar"]="archives" ["gz"]="archives"  ["xz"]="archives"
    ["zip"]="archives" ["rar"]="archives" ["7z"]="archives"
    ["bz2"]="archives" ["zst"]="archives"
    ["ttf"]="fonts"    ["otf"]="fonts"    ["woff"]="fonts"
    ["woff2"]="fonts"
)

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -d, --dry-run       Show what would be moved without doing it"
    echo "  -v, --verbose       Verbose output"
    echo "  -i, --interactive   Confirm each move"
    echo "  -c, --create        Only create directory structure"
    echo "  -h, --help          Show this help"
}

log() {
    local type="$1"; local msg="$2"
    case "$type" in
        move)  echo -e "  ${GREEN}→${NC} $msg" ;;
        skip)  [[ "$VERBOSE" == true ]] && echo -e "  ${YELLOW}↷${NC} $msg (skipped)" ;;
        mkdir) [[ "$VERBOSE" == true ]] && echo -e "  ${BLUE}+${NC} $msg" ;;
        info)  echo -e "  ${CYAN}i${NC} $msg" ;;
        warn)  echo -e "  ${RED}!${NC} $msg" ;;
    esac
}

create_directories() {
    echo -e "${CYAN}[INFO]${NC} Creating directory structure..."
    for key in "${!DIRS[@]}"; do
        local dir="$DOWNLOADS_DIR/${DIRS[$key]}"
        if [[ ! -d "$dir" ]]; then
            if [[ "$DRY_RUN" == false ]]; then
                mkdir -p "$dir"
            fi
            log "mkdir" "${DIRS[$key]}"
        fi
    done
}

classify_item() {
    local item="$1"
    local basename
    basename=$(basename "$item")
    local lower="${basename,,}"

    # Skip already-organized dirs and hidden files
    [[ "$basename" == .* ]] && echo "skip" && return
    for key in "${!DIRS[@]}"; do
        [[ "$basename" == "${DIRS[$key]%%/*}" ]] && echo "skip" && return
    done
    [[ -d "$item" ]] && {
        # Wallpaper dirs
        [[ "$lower" =~ wallpaper ]] && echo "wallpapers" && return
        # Torrent/media dirs — season packs, release groups, etc.
        [[ "$lower" =~ (s[0-9]{2}|season|1080p|720p|bluray|webrip|web-dl|hevc|x265|x264|\[.*\]|complete) ]] && echo "torrents" && return
        # Theme dirs
        [[ "$lower" =~ (grub|grub2) ]] && echo "grub" && return
        [[ "$lower" =~ (icon|cursor) ]] && echo "icons" && return
        [[ "$lower" =~ (font|nerd) ]] && echo "fonts" && return
        [[ "$lower" =~ (plasma|kde|latte|kvantum) ]] && echo "kde" && return
        echo "skip" && return
    }

    # Wallpaper detection by name
    [[ "$lower" =~ (wallpaper|3840x|2560x|4k|uhd) ]] && echo "wallpapers" && return

    # Extension-based classification
    local ext="${basename##*.}"
    local ext_lower="${ext,,}"
    [[ -n "${EXT_MAP[$ext_lower]}" ]] && echo "${EXT_MAP[$ext_lower]}" && return
    # AppImage has capital I
    [[ "$basename" == *.AppImage ]] && echo "appimages" && return

    echo "skip"
}

move_file() {
    local src="$1"; local category="$2"
    local dest_dir="$DOWNLOADS_DIR/${DIRS[$category]}"
    local basename
    basename=$(basename "$src")
    local dest="$dest_dir/$basename"

    # Handle conflicts
    if [[ -e "$dest" ]]; then
        local ts
        ts=$(date +%s)
        dest="$dest_dir/${basename%.*}_$ts.${basename##*.}"
    fi

    if [[ "$DRY_RUN" == true ]]; then
        log "move" "$basename → ${DIRS[$category]}/"
    else
        mv "$src" "$dest" && log "move" "$basename → ${DIRS[$category]}/"
    fi
}

organize_files() {
    local moved=0 skipped=0
    echo -e "${CYAN}[INFO]${NC} Scanning Downloads folder..."
    echo ""

    while IFS= read -r -d '' item; do
        local basename
        basename=$(basename "$item")

        # Skip the organized subdirs themselves
        local is_subdir=false
        for key in "${!DIRS[@]}"; do
            local top="${DIRS[$key]%%/*}"
            [[ "$basename" == "$top" ]] && is_subdir=true && break
        done
        [[ "$is_subdir" == true ]] && continue

        local category
        category=$(classify_item "$item")

        if [[ "$category" == "skip" ]]; then
            log "skip" "$basename"
            ((skipped++))
            continue
        fi

        if [[ "$INTERACTIVE" == true ]]; then
            printf "  Move '%s' → %s? [y/N/q] " "$basename" "${DIRS[$category]}"
            read -r response
            case "$response" in
                [yY]) move_file "$item" "$category"; ((moved++)) ;;
                [qQ]) echo "Aborted."; exit 0 ;;
                *) log "skip" "$basename"; ((skipped++)) ;;
            esac
        else
            move_file "$item" "$category"
            ((moved++))
        fi
    done < <(find "$DOWNLOADS_DIR" -maxdepth 1 -mindepth 1 -print0 | sort -z)

    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    if [[ "$DRY_RUN" == true ]]; then
        echo -e "  Dry run complete: ${CYAN}$moved${NC} files would be moved"
    else
        echo -e "  Organization complete: ${GREEN}$moved${NC} files moved"
    fi
    echo -e "  Skipped: ${YELLOW}$skipped${NC} items"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)     DRY_RUN=true; shift ;;
        -v|--verbose)     VERBOSE=true; shift ;;
        -c|--create)      CREATE_ONLY=true; shift ;;
        -i|--interactive) INTERACTIVE=true; shift ;;
        -h|--help)        usage; exit 0 ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
done

echo ""
echo -e "${CYAN}╔═══════════════════════════════════════╗${NC}"
echo -e "${CYAN}║    Downloads Folder Organizer         ║${NC}"
echo -e "${CYAN}╚═══════════════════════════════════════╝${NC}"
echo ""

[[ "$DRY_RUN" == true ]] && echo -e "${YELLOW}Running in dry-run mode${NC}\n"

create_directories
[[ "$CREATE_ONLY" == false ]] && organize_files
