[General]
Order=overcast-brave-tiled,overcast-spectacle-above

[overcast-brave-tiled]
Description=Overcast: Brave opens tiled, not maximised
maximizehoriz=false
maximizehorizrule=3
maximizevert=false
maximizevertrule=3
types=1
wmclass=brave
wmclassmatch=2

[overcast-spectacle-above]
Description=Overcast: Spectacle stays above tiled windows
above=true
aboverule=3
types=1
wmclass=org.kde.spectacle
wmclassmatch=1
