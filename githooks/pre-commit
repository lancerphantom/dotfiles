#!/usr/bin/env bash
# Refuse commits that would put credentials into the dotfiles repo.
# Enable once per clone:  git -C ~/dotfiles config core.hooksPath githooks
#
# Blocks by path (gh's token file, ~/.config/secrets, ssh/gpg dirs, key files)
# and by content (GitHub tokens, private key blocks). Bypass only if you are
# sure: git commit --no-verify
set -uo pipefail

bad=0
while IFS= read -r -d '' f; do
    case "/$f" in
        */.config/gh/*|*/gh/hosts.yml|*/.config/secrets/*|*/.ssh/*|*/.gnupg/*|*.key|*.pem)
            echo "pre-commit: refusing credential path: $f" >&2; bad=1 ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Split so this file doesn't match itself.
oauth='oauth''_token:'
pattern="(gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|$oauth|BEGIN [A-Z ]*PRIVATE KEY)"
if git diff --cached -U0 --diff-filter=ACMR | grep -nE "^\+.*$pattern" >&2; then
    echo "pre-commit: staged changes contain what looks like a token or private key (lines above)" >&2
    bad=1
fi

exit "$bad"
